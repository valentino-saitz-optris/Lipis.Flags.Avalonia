<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>Andrea Luciano Damico</Authors>
        <Description>Provides an Avalonia value converter that converts an ISO 3166-1 alpha-2 country code into an Avalonia Svg of that country's flag.</Description>
        <Version>12.0.0</Version>
        <Title>Lipis.Flags.Avalonia</Title>
        <PackageProjectUrl>https://github.com/ALDamico/Lipis.Flags.Avalonia</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ALDamico/Lipis.Flags.Avalonia</RepositoryUrl>
        <RepositoryType>github</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <!--
        IsAotCompatible implies IsTrimmable plus the trim, AOT and single-file analyzers, so a
        pattern the trimmer cannot see through fails this build rather than a consumer's publish.
    -->
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.1"/>
        <!--
            Svg.Controls.Avalonia, not Svg.Controls.Skia.Avalonia: the latter carries its own
            SkiaSharp native assets, which collide with the ones Avalonia already ships.
        -->
        <PackageReference Include="Svg.Controls.Avalonia" Version="12.0.0.17"/>
    </ItemGroup>

    <!--
        The country table is generated from country.json so the names and the artwork always come
        from the same upstream release. It is build output, not source: country.json is the file
        worth reviewing. Inputs and Outputs make this a no-op on an up-to-date build; both target
        frameworks share the output path, so this runs in the outer build before they are
        dispatched: two inner builds invoking the generator at once collide over its own obj.
    -->
    <PropertyGroup>
        <_CountryTable>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'generated', 'CountryData.g.cs'))</_CountryTable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(_CountryTable)"/>
    </ItemGroup>

    <Target Name="GenerateCountryTable"
            BeforeTargets="DispatchToInnerBuilds;BeforeCompile"
            Inputs="$(MSBuildProjectDirectory)/../country.json;$(MSBuildProjectDirectory)/../tools/FlagGenerator/Program.cs"
            Outputs="$(_CountryTable)">
        <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../tools/FlagGenerator/FlagGenerator.csproj&quot; -c Release -- &quot;$(MSBuildProjectDirectory)/..&quot; &quot;$(_CountryTable)&quot;"
              WorkingDirectory="$(MSBuildProjectDirectory)/.."/>
    </Target>

    <!--
        One embedded archive rather than ~540 resources: 3.87 MB of assembly becomes 1.36 MB.
        Staged under a fixed timestamp first, because a zip entry records its file's last-write time
        and a checkout rewrites those. EmbeddedResource sits inside the target because an item group
        at project scope is evaluated before the file it names exists.
    -->
    <Target Name="PackFlagAssets" BeforeTargets="PrepareForBuild">
        <ItemGroup>
            <_FlagAsset Include="Assets\**\*.svg"/>
            <_StagedFlag Include="@(_FlagAsset->'$(IntermediateOutputPath)flags\%(RecursiveDir)%(Filename)%(Extension)')"/>
        </ItemGroup>
        <RemoveDir Directories="$(IntermediateOutputPath)flags"/>
        <Copy SourceFiles="@(_FlagAsset)" DestinationFiles="@(_StagedFlag)"/>
        <Touch Files="@(_StagedFlag)" Time="1980-01-01T00:00:00"/>
        <ZipDirectory SourceDirectory="$(IntermediateOutputPath)flags"
                      DestinationFile="$(IntermediateOutputPath)flags.zip"
                      Overwrite="true"/>
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)flags.zip" LogicalName="flags.zip"/>
        </ItemGroup>
    </Target>

    <!--
        An empty asset directory zips and packs without complaint, so assert a count rather than
        presence. A floor, so an upstream add or retirement needs no manual bump, plus an equality
        check the floor alone would miss. GenerateNuspec too: a pack can skip the build.
    -->
    <Target Name="VerifyFlagAssets" BeforeTargets="PrepareForBuild;GenerateNuspec">
        <PropertyGroup>
            <_MinimumFlagCount>250</_MinimumFlagCount>
        </PropertyGroup>
        <ItemGroup>
            <_FourByThreeFlags Include="Assets\4x3\*.svg"/>
            <_OneByOneFlags Include="Assets\1x1\*.svg"/>
        </ItemGroup>
        <Error Condition="'@(_FourByThreeFlags->Count())' &lt; '$(_MinimumFlagCount)'"
               Text="Found only @(_FourByThreeFlags->Count()) flags in Assets\4x3, below the floor of $(_MinimumFlagCount). The vendored flag assets are missing or incomplete."/>
        <Error Condition="'@(_OneByOneFlags->Count())' &lt; '$(_MinimumFlagCount)'"
               Text="Found only @(_OneByOneFlags->Count()) flags in Assets\1x1, below the floor of $(_MinimumFlagCount). The vendored flag assets are missing or incomplete."/>
        <Error Condition="'@(_FourByThreeFlags->Count())' != '@(_OneByOneFlags->Count())'"
               Text="Assets\4x3 has @(_FourByThreeFlags->Count()) flags but Assets\1x1 has @(_OneByOneFlags->Count()). The two aspect-ratio sets must match."/>
    </Target>

    <ItemGroup>
        <Content Include="../README.md"><Pack>True</Pack><PackagePath>\</PackagePath></Content>
    </ItemGroup>

</Project>
