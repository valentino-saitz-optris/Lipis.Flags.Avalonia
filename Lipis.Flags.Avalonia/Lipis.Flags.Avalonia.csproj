<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>Andrea Luciano Damico</Authors>
        <Description>Provides an Avalonia value converter that converts an ISO 3166-1 alpha-2 country code into an Avalonia Svg of that country's flag.</Description>
        <Version>12.0.0</Version>
        <Title>Lipis.Flags.Avalonia</Title>
        <PackageProjectUrl>https://github.com/ALDamico/Lipis.Flags.Avalonia</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ALDamico/Lipis.Flags.Avalonia</RepositoryUrl>
        <RepositoryType>github</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <!--
        IsAotCompatible implies IsTrimmable plus the trim, AOT and single-file analyzers, so a
        pattern the trimmer cannot see through fails this build rather than a consumer's publish.
    -->
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.1"/>
        <!--
            Svg.Controls.Avalonia, not Svg.Controls.Skia.Avalonia: the latter carries its own
            SkiaSharp native assets, which collide with the ones Avalonia already ships.
        -->
        <PackageReference Include="Svg.Controls.Avalonia" Version="12.0.0.17"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\1x1\**"/>
        <AvaloniaResource Include="Assets\4x3\**"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include="../README.md"><Pack>True</Pack><PackagePath>\</PackagePath></Content>
    </ItemGroup>

</Project>
