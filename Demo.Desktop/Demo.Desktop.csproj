<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Demo\Demo.csproj"/>
    </ItemGroup>

    <!--
        Keincheck drives the sample UI without a human at the screen. Debug-only, so a Release
        build carries neither the package nor its dependencies; the matching call site in
        Program.cs is guarded by #if DEBUG.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Keincheck.Avalonia" Version="0.12.0"/>
    </ItemGroup>

</Project>
