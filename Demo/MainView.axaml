<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Demo.Views"
             xmlns:vm="clr-namespace:Demo.ViewModels"
             x:Class="Demo.MainView"
             x:DataType="vm:MainViewModel">

    <Panel Background="{DynamicResource DemoPageBackground}">
        <DockPanel>

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource DemoCardBackground}"
                    BorderBrush="{DynamicResource DemoCardBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="h1" Text="Lipis.Flags.Avalonia"/>
                        <TextBlock Classes="caption"
                                   TextTrimming="CharacterEllipsis"
                                   Text="271 SVG flags and a culture-to-flag mapping. This sample doubles as the library's manual smoke test."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="caption" Text="Rendering with"/>
                            <TextBlock Classes="mono" FontSize="13" Text="{Binding AvaloniaVersionLabel}"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Classes="caption" Text="Theme"/>
                            <ComboBox SelectedIndex="0" MinWidth="112" SelectionChanged="OnThemeSelectionChanged">
                                <ComboBoxItem Content="System"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Margin="10,6,10,10">
                <TabItem Header="All flags">
                    <views:GalleryView DataContext="{Binding Gallery}"/>
                </TabItem>
                <TabItem Header="Culture mapping">
                    <views:CultureView DataContext="{Binding Cultures}"/>
                </TabItem>
                <TabItem Header="Usage">
                    <views:UsageView DataContext="{Binding Usage}"/>
                </TabItem>
            </TabControl>

        </DockPanel>
    </Panel>

</UserControl>
